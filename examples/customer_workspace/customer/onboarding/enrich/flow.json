{
  "id": "customer.onboarding.enrich",
  "description": "Deduplicate customers and score them before profile creation.",
  "input": "CustomerDraft",
  "entry_node": "dedupe",
  "nodes": {
    "dedupe": {
      "kind": "python",
      "label": "Deduplicate",
      "ref": ".dedupe:process",
      "input": "CustomerDraft",
      "exits": {
        "out": {
          "type": "CustomerDraft"
        }
      }
    },
    "score_customer": {
      "kind": "flow",
      "label": "Score customer",
      "ref": "customer.scoring",
      "input": "CustomerDraft",
      "exits": {
        "priority": {
          "type": "PriorityCustomer"
        },
        "standard": {
          "type": "ScoredCustomer"
        }
      }
    },
    "prepare_profile": {
      "kind": "python",
      "label": "Prepare profile",
      "ref": ".prepare_profile:process",
      "input": "Any",
      "exits": {
        "out": {
          "type": "EnrichedCustomer"
        }
      }
    }
  },
  "edges": [
    {
      "from_node": "dedupe",
      "from_exit": "out",
      "to_node": "score_customer"
    },
    {
      "from_node": "score_customer",
      "from_exit": "priority",
      "to_node": "prepare_profile"
    },
    {
      "from_node": "score_customer",
      "from_exit": "standard",
      "to_node": "prepare_profile"
    },
    {
      "from_node": "prepare_profile",
      "from_exit": "out",
      "to_flow_exit": "out"
    }
  ],
  "public_exits": {
    "out": {
      "type": "EnrichedCustomer"
    }
  },
  "layout": {
    "nodes": {
      "dedupe": {
        "x": 180,
        "y": 120
      },
      "score_customer": {
        "x": 180,
        "y": 340
      },
      "prepare_profile": {
        "x": 180,
        "y": 610
      }
    },
    "viewport": {
      "x": 20,
      "y": -10,
      "zoom": 0.92
    }
  }
}
