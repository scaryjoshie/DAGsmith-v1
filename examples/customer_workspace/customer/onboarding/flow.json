{
  "id": "customer.onboarding",
  "description": "Validate and enrich incoming customer onboarding records.",
  "input": "RawCustomer",
  "entry_node": "load",
  "nodes": {
    "load": {
      "kind": "python",
      "label": "Load record",
      "ref": ".load:process",
      "input": "RawCustomer",
      "exits": {
        "out": {
          "type": "CustomerDraft",
          "description": "Parsed incoming customer."
        }
      }
    },
    "validate_email": {
      "kind": "python",
      "label": "Validate email",
      "ref": ".validate_email:process",
      "selector": ".validate_email:branch",
      "input": "CustomerDraft",
      "exits": {
        "valid": {
          "type": "CustomerDraft",
          "description": "Customer can continue."
        },
        "invalid": {
          "type": "ValidationError",
          "description": "Customer needs manual follow-up."
        }
      }
    },
    "enrich_profile": {
      "kind": "flow",
      "label": "Enrich profile",
      "ref": "customer.onboarding.enrich",
      "input": "CustomerDraft",
      "exits": {
        "out": {
          "type": "EnrichedCustomer",
          "description": "Customer is enriched and ready."
        }
      }
    }
  },
  "edges": [
    {
      "from_node": "load",
      "from_exit": "out",
      "to_node": "validate_email"
    },
    {
      "from_node": "validate_email",
      "from_exit": "valid",
      "to_node": "enrich_profile"
    },
    {
      "from_node": "validate_email",
      "from_exit": "invalid",
      "to_flow_exit": "invalid"
    },
    {
      "from_node": "enrich_profile",
      "from_exit": "out",
      "to_flow_exit": "accepted"
    }
  ],
  "public_exits": {
    "accepted": {
      "type": "EnrichedCustomer",
      "description": "A fully prepared customer profile."
    },
    "invalid": {
      "type": "ValidationError",
      "description": "A customer that failed validation."
    }
  },
  "layout": {
    "nodes": {
      "load": {
        "x": 180,
        "y": 120
      },
      "validate_email": {
        "x": 180,
        "y": 330
      },
      "enrich_profile": {
        "x": 180,
        "y": 560
      }
    },
    "viewport": {
      "x": -40,
      "y": -10,
      "zoom": 0.95
    }
  }
}
